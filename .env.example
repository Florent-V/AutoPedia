# Copier ce fichier en .env puis adapter les valeurs.

# Secret de signature des sessions : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique du site (https://… en production)
PUBLIC_URL=http://localhost:3000
POSTGRES_PASSWORD=garage
WEB_PORT=3000
DB_PORT=5432
# true si un reverse proxy (Caddy, Traefik, Nginx…) est placé devant le site
TRUST_PROXY=false

# Réglages du jeu
BOOSTER_REGEN_MINUTES=30
BOOSTER_MAX=10
CARDS_PER_BOOSTER=5

# Catalogue : wikidata (repli automatique sur le jeu de secours), seed, ou off
CATALOG_AUTO_IMPORT=wikidata
CATALOG_IMPORT_LIMIT=3000
# Catalogue Wikimedia : contact transmis dans le User-Agent (exigé par Wikimedia), ex. « https://monsite.fr; moi@exemple.fr »
WIKI_CONTACT=
# Jeton personnel Wikimedia (facultatif, relève les limites de débit) : https://api.wikimedia.org/wiki/Special:AppManagement
WIKIMEDIA_TOKEN=
# Afficher l'image distante (Wikimedia) tant que la copie locale n'est pas encore téléchargée
MEDIA_REMOTE_FALLBACK=true
# Jeton (≥ 16 caractères) pour POST /api/admin/catalog/import
ADMIN_TOKEN=

# Notifications push (PWA) — générer avec : npx web-push generate-vapid-keys
# Laisser vide pour désactiver les notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Économie (crédits, mini-jeux, boutique, bourse)
GAME_TIMEZONE=Europe/Paris
STARTING_CREDITS=100
GAMES_PER_DAY=3
TRADE_DAYS=7
MAX_OPEN_TRADES=10
# Garanties de tirage : Épique au plus tard au Ne booster, Légendaire au Ne booster
PITY_EPIC=10
PITY_LEGENDARY=60
# Graine secrète du programme de la boutique (par défaut dérivée de BETTER_AUTH_SECRET)
SHOP_SECRET=
