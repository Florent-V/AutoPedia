# Configuration par défaut (développement). En production, les variables viennent de Docker.
# Les variables du jeu ont les mêmes noms et valeurs par défaut que le backend NestJS (voir config/services.yaml).
APP_ENV=dev
APP_SECRET=change-me-dev-only-secret
DATABASE_URL="postgresql://garage:garage@127.0.0.1:5432/garage_symfony?serverVersion=16&charset=utf8"
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000
LOCK_DSN=flock
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
DEFAULT_URI=http://localhost
