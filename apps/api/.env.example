DATABASE_URL=postgresql://garage:garage@localhost:5432/garage
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# URL publique du site (le front Nuxt proxifie /api vers l'API)
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=3001
# Réglages du jeu
BOOSTER_REGEN_MINUTES=30
BOOSTER_MAX=10
CARDS_PER_BOOSTER=5
# Import du catalogue au démarrage si celui-ci est vide (wikidata | seed | off)
CATALOG_AUTO_IMPORT=wikidata
CATALOG_IMPORT_LIMIT=3000
# Jeton pour POST /api/admin/catalog/import (laisser vide pour désactiver)
ADMIN_TOKEN=
# Notifications push (PWA). Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Catalogue Wikimedia : contact transmis dans le User-Agent (exigé par Wikimedia), ex. « https://monsite.fr; moi@exemple.fr »
WIKI_CONTACT=
# Jeton personnel Wikimedia (facultatif, relève les limites de débit) : https://api.wikimedia.org/wiki/Special:AppManagement
WIKIMEDIA_TOKEN=
# Afficher l'image distante (Wikimedia) tant que la copie locale n'est pas encore téléchargée
MEDIA_REMOTE_FALLBACK=true
# Dossier de stockage des photos
MEDIA_DIR=./media

# Économie (crédits, mini-jeux, boutique, bourse)
GAME_TIMEZONE=Europe/Paris
STARTING_CREDITS=100
GAMES_PER_DAY=3
QUICK_GAMES_PER_DAY=5
DOORS_PER_DAY=2
TRADE_DAYS=7
MAX_OPEN_TRADES=10
# Garanties de tirage : Épique au plus tard au Ne booster, Légendaire au Ne booster
PITY_EPIC=10
PITY_LEGENDARY=60
# Graine secrète du programme de la boutique (par défaut dérivée de BETTER_AUTH_SECRET)
SHOP_SECRET=

# Enchères
AUCTION_FEE_PERCENT=5
MAX_OPEN_AUCTIONS=5

# Bots (joueurs automatiques qui animent le marché au lancement)
BOTS_ENABLED=true
BOTS_COUNT=12
BOTS_START_CREDITS=1500
BOTS_TICK_SECONDS=60
