{
  "rootDir": "..",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.json",
        "diagnostics": {
          "ignoreCodes": [
            151002
          ]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "globalTeardown": "<rootDir>/test/global-teardown.ts",
  "testTimeout": 30000
}
