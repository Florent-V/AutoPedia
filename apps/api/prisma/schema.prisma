generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentification (schéma attendu par Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  player             Player?
  cards              UserCard[]
  openings           BoosterOpening[]
  achievements       UserAchievement[]
  pushSubscriptions  PushSubscription[]
  creditTransactions CreditTransaction[]
  gameSessions       GameSession[]
  shopPurchases      ShopPurchase[]
  tradeOffers        TradeOffer[]        @relation("TradeSeller")
  tradePurchases     TradeOffer[]        @relation("TradeBuyer")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Jeu
// ---------------------------------------------------------------------------

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// Une carte du catalogue = un modèle de voiture (source : Wikidata / Wikipedia).
model Car {
  id               Int       @id @default(autoincrement())
  /// Identifiant Wikidata (ex. Q172146) ou "seed:<slug>" pour le jeu de secours.
  externalId       String    @unique
  name             String
  manufacturer     String?
  country          String?
  yearStart        Int?
  yearEnd          Int?
  /// URL distante de l'image (repli si la copie locale n'existe pas encore).
  imageUrl         String?
  /// Nom du fichier sur Wikimedia Commons (ex. « Ferrari F40.jpg »).
  imageFile        String?
  /// Chemin de la copie locale, relatif à MEDIA_DIR (ex. « cars/Q172146-1a2b3c4d.webp »).
  imagePath        String?
  imageAuthor      String?
  imageLicense     String?
  imageLicenseUrl  String?
  /// Dernière tentative de téléchargement (évite de réessayer en boucle les échecs).
  imageCheckedAt   DateTime?
  /// Titre de l'article Wikipédia (fr si disponible, sinon en).
  wikiTitle        String?
  wikiLang         String?
  /// Résumé Wikipédia, mis en cache à la première consultation.
  summary          String?
  summaryFetchedAt DateTime?
  powerKw          Float?
  topSpeedKmh      Float?
  massKg           Float?
  lengthMm         Int?
  /// Voiture de compétition (F1, endurance, rallye…).
  racing           Boolean   @default(false)
  /// Indicateur de notoriété (nombre d'articles Wikipédia liés) : sert à calculer la rareté.
  popularity       Int       @default(0)
  rarity           Rarity    @default(COMMON)
  /// Permet de forcer manuellement une rareté (non écrasée par les imports).
  rarityOverride   Rarity?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owners    UserCard[]
  offeredIn TradeOffer[] @relation("TradeOffered")
  wantedIn  TradeOffer[] @relation("TradeWanted")

  @@index([rarity, active])
  @@index([manufacturer])
  @@index([imagePath])
  @@map("car")
}

/// État de jeu d'un joueur (réserve de boosters, statistiques).
model Player {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Boosters disponibles au moment de `boosterAnchor`.
  boosters           Int
  /// Point de départ du minuteur de régénération.
  boosterAnchor      DateTime  @default(now())
  /// Ancre pour laquelle la notification « réserve pleine » a déjà été envoyée.
  fullNotifiedAnchor DateTime?
  boostersOpened     Int       @default(0)
  cardsObtained      Int       @default(0)
  /// Boosters ouverts depuis la dernière carte Épique ou mieux (garantie).
  sinceEpic          Int       @default(0)
  /// Boosters ouverts depuis la dernière carte Légendaire (garantie).
  sinceLegendary     Int       @default(0)
  /// Solde de crédits (monnaie du jeu, gagnée dans les mini-jeux).
  credits            Int       @default(0)
  creditsEarned      Int       @default(0)
  gamesPlayed        Int       @default(0)
  tradesCompleted    Int       @default(0)
  shopPurchases      Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("player")
}

/// Journal de tous les mouvements de crédits (audit, anti-triche, historique joueur).
model CreditTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Positif = gain, négatif = dépense.
  amount    Int
  /// game:duel, game:quiz, shop, trade:sale, trade:purchase, welcome…
  reason    String
  /// Référence de l'objet concerné (session de jeu, offre, achat).
  ref       String?
  balance   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_transaction")
}

enum GameType {
  DUEL
  QUIZ
}

enum GameStatus {
  ACTIVE
  FINISHED
}

/// Partie de mini-jeu. Les bonnes réponses restent côté serveur (champ `state`), jamais envoyées au client.
model GameSession {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GameType
  status      GameStatus @default(ACTIVE)
  state       Json
  round       Int        @default(0)
  score       Int        @default(0)
  credits     Int        @default(0)
  rewardCarId Int?
  createdAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([userId, type, createdAt])
  @@map("game_session")
}

/// Achat dans la boutique de l'application (une offre horaire = un achat max par joueur).
model ShopPurchase {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant de l'offre : « 2026-10-15T14:<rareté>:<position> ».
  offerKey  String
  carId     Int
  price     Int
  createdAt DateTime @default(now())

  @@unique([userId, offerKey])
  @@map("shop_purchase")
}

enum TradeStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Offre de la bourse d'échanges : une carte proposée contre une carte précise ou des crédits.
/// La carte proposée est mise sous séquestre (retirée de la collection) tant que l'offre est ouverte.
model TradeOffer {
  id           String      @id @default(uuid())
  sellerId     String
  seller       User        @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  offeredCarId Int
  offeredCar   Car         @relation("TradeOffered", fields: [offeredCarId], references: [id], onDelete: Cascade)
  wantedCarId  Int?
  wantedCar    Car?        @relation("TradeWanted", fields: [wantedCarId], references: [id], onDelete: Cascade)
  price        Int?
  status       TradeStatus @default(OPEN)
  buyerId      String?
  buyer        User?       @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  closedAt     DateTime?

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@index([offeredCarId, status])
  @@index([wantedCarId, status])
  @@map("trade_offer")
}

/// Cartes possédées. Une ligne par (joueur, carte) avec un nombre d'exemplaires :
/// ce modèle permettra plus tard l'échange de doublons entre amis.
model UserCard {
  userId          String
  carId           Int
  quantity        Int      @default(1)
  firstObtainedAt DateTime @default(now())
  lastObtainedAt  DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car             Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@id([userId, carId])
  @@index([carId])
  @@map("user_card")
}

/// Historique des ouvertures de boosters.
model BoosterOpening {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carIds    Int[]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("booster_opening")
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievement")
}

/// Abonnement Web Push d'un appareil (PWA installée ou navigateur).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}
